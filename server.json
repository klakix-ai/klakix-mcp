{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.klakix/mcp",
  "title": "Klakix",
  "description": "AI video, image, voiceover and music generation: Veo, Kling, Seedance, Nano Banana, GPT Image.",
  "version": "0.1.1",
  "websiteUrl": "https://klakix.com/mcp",
  "repository": {
    "url": "https://github.com/klakix-ai/klakix-mcp",
    "source": "github"
  },
  "icons": [
    { "src": "https://klakix.com/logo-512.png", "mimeType": "image/png", "sizes": ["512x512"] }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://klakix.com/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "klakix-mcp",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "KLAKIX_API_KEY",
          "description": "API key from https://klakix.com/app/mcp",
          "isRequired": true,
          "isSecret": true
        }
      ]
    },
    {
      "registryType": "pypi",
      "identifier": "klakix-mcp",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "KLAKIX_API_KEY",
          "description": "API key from https://klakix.com/app/mcp",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
